# Copy to .env and fill in, or to ~/.config/research-cli/env (the CLI loads that file).
# Do not commit .env.

# Brave Search: BRAVE_API_KEY or BRAVE_SEARCH_API_KEY
BRAVE_API_KEY=
# BRAVE_SEARCH_API_KEY=

EXA_API_KEY=
FIRECRAWL_API_KEY=

# Optional. Free tier works without a key.
# BGPT_API_KEY=

# Reddit OAuth app at https://www.reddit.com/prefs/apps (script or web).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Sploitus exploit/hacktool search needs no key. Malpedia catalog/YARA needs no key.

# X (Twitter) web session. From a logged-in browser: cookies auth_token and ct0.
# Never commit these. Guest search is not available.
# The CLI does not auto-load this file; copy into ~/.config/research-cli/env or export.
X_AUTH_TOKEN=
X_CT0=

# TGStat Premium-search website (not Search API). From a logged-in tgstat.com
# browser: HttpOnly cookies tgstat_idrk → TGSTAT_IDR and tgstat_sirk → TGSTAT_SIRK.
# Optional _tgstat_csrk / tgstat_settings. CSRF is fetched per search.
# Never commit these. Guest search is not available.
TGSTAT_IDR=
TGSTAT_SIRK=
# TGSTAT_CSRK=
# TGSTAT_SETTINGS=

# Telegram user session (not a BotFather token). Login once; the CLI saves
# TELEGRAM_SESSION here and ~/.config/research-cli/telegram.session. Later
# discover/history/download reuse that file — no phone/code again until you
# revoke the device in Telegram. Copy this env file (and telegram.session)
# to a server. Never commit them. Public post search is tgstat, not telegram.
#   research-cli telegram login --api-id ID --api-hash HASH --phone +COUNTRY…
#   research-cli telegram login --code CODE
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
# TELEGRAM_SESSION_FILE=

# Copy to .env and fill in, or to ~/.config/research-cli/env (the CLI loads that file).
# Do not commit .env.

# Brave Search: BRAVE_API_KEY or BRAVE_SEARCH_API_KEY
BRAVE_API_KEY=
# BRAVE_SEARCH_API_KEY=

EXA_API_KEY=
FIRECRAWL_API_KEY=

# Optional. Free tier works without a key.
# BGPT_API_KEY=

# Reddit OAuth app at https://www.reddit.com/prefs/apps (script or web).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Sploitus exploit/hacktool search needs no key. Malpedia catalog/YARA needs no key.
